# ==============================================================================
# Rorqual Cluster Configuration
# ==============================================================================

# Enable/disable Rorqual integration
# Set to 'True' to use Rorqual cluster, 'False' to use OpenAI API
RORQUAL_ENABLED=False

# Rorqual Login Credentials
RORQUAL_HOST=rorqual.alliancecan.ca
RORQUAL_USERNAME=your_username_here
RORQUAL_SSH_KEY_PATH=~/.ssh/id_rsa

# Rorqual Project Settings
# Replace with your actual project directory and AIP account
RORQUAL_PROJECT_DIR=/home/your_username/projects/def-pi/genai-teachers
RORQUAL_ACCOUNT=aip-123456

# Model Configuration
RORQUAL_MODEL_NAME=openai/gpt-oss-20b
RORQUAL_MODEL_PATH=models/gpt-oss-20b

# Inference Server Settings
RORQUAL_INFERENCE_PORT=8000
RORQUAL_LOCAL_PORT=8080

# State File Location
RORQUAL_STATE_FILE=~/.rorqual_node_state.json

# Timeouts (in seconds)
RORQUAL_JOB_TIMEOUT=86400           # 24 hours (max job duration)
RORQUAL_IDLE_SHUTDOWN=3600          # 1 hour (auto-shutdown after inactivity)
RORQUAL_STARTUP_TIMEOUT=300         # 5 minutes (wait for node to start)
RORQUAL_SERVER_READY_TIMEOUT=300    # 5 minutes (wait for server to be ready)
RORQUAL_REQUEST_TIMEOUT=120         # 2 minutes (individual request timeout)

# SLURM Job Configuration
RORQUAL_JOB_NAME=genai-inference
RORQUAL_GPUS=h100:4
RORQUAL_CPUS=48
RORQUAL_MEMORY=200G

# Feature Flags
RORQUAL_AUTO_SHUTDOWN=True          # Enable auto-shutdown after idle timeout
RORQUAL_DEBUG=False                 # Enable debug logging

# ==============================================================================
# OpenAI Configuration (used for routing and when Rorqual is disabled)
# ==============================================================================

OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Django Configuration
# ==============================================================================

# Add any other Django-specific environment variables here
