# ==============================================================================
# TamIA Cluster Configuration
# ==============================================================================

# Enable/disable TamIA integration
# Set to 'True' to use TamIA cluster, 'False' to use OpenAI API
TAMIA_ENABLED=False

# TamIA Login Credentials
TAMIA_HOST=tamia.alliancecan.ca
TAMIA_USERNAME=your_username_here
TAMIA_SSH_KEY_PATH=~/.ssh/id_rsa

# TamIA Project Settings
# Replace with your actual project directory and AIP account
TAMIA_PROJECT_DIR=/home/your_username/projects/def-pi/genai-teachers
TAMIA_ACCOUNT=aip-123456

# Model Configuration
TAMIA_MODEL_NAME=openai/gpt-oss-20b
TAMIA_MODEL_PATH=models/gpt-oss-20b

# Inference Server Settings
TAMIA_INFERENCE_PORT=8000
TAMIA_LOCAL_PORT=8080

# State File Location
TAMIA_STATE_FILE=~/.tamia_node_state.json

# Timeouts (in seconds)
TAMIA_JOB_TIMEOUT=86400           # 24 hours (max job duration)
TAMIA_IDLE_SHUTDOWN=3600          # 1 hour (auto-shutdown after inactivity)
TAMIA_STARTUP_TIMEOUT=300         # 5 minutes (wait for node to start)
TAMIA_SERVER_READY_TIMEOUT=300    # 5 minutes (wait for server to be ready)
TAMIA_REQUEST_TIMEOUT=120         # 2 minutes (individual request timeout)

# SLURM Job Configuration
TAMIA_JOB_NAME=genai-inference
TAMIA_GPUS=h100:4
TAMIA_CPUS=48
TAMIA_MEMORY=200G

# Feature Flags
TAMIA_AUTO_SHUTDOWN=True          # Enable auto-shutdown after idle timeout
TAMIA_DEBUG=False                 # Enable debug logging

# ==============================================================================
# OpenAI Configuration (used for routing and when TamIA is disabled)
# ==============================================================================

OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Django Configuration
# ==============================================================================

# Add any other Django-specific environment variables here
